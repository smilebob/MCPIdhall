# Copier en `.env` (ou passer via `docker compose --env-file .env.docker up -d`)
# Aucun jeton JWT ne doit être mis ici : chaque utilisateur fournit son propre JWT
# dans l'en-tête HTTP `Authorization: Bearer <jwt>`.

# Adresse et port d'écoute sur l'hôte (127.0.0.1 recommandé si reverse proxy sur le même hôte)
MCP_BIND_IP=127.0.0.1
MCP_PORT=8000

# Transport MCP : streamable-http (recommandé, endpoint /mcp) ou sse (endpoint /sse)
MCP_TRANSPORT=streamable-http

# Hôtes IDhall HTTPS autorisés :
# - '*.idhall.com' (défaut sécurisé) : toutes les instances SaaS IDhall
# - 'mon-entreprise.idhall.com' : verrouille sur une seule instance
# - '*.idhall.com,idhall.mon-entreprise.intra' : liste séparée par des virgules
IDHALL_ALLOWED_HOSTS=*.idhall.com

# Protection anti-SSRF : bloque les IP privées/loopback/metadata par défaut.
# Passez à 'true' uniquement si votre instance IDhall on-premise est sur un réseau interne privé.
IDHALL_ALLOW_PRIVATE_NETWORKS=false

# Mode lecture seule strict (optionnel) : passez à 'true' pour bloquer POST/PUT/PATCH/DELETE
IDHALL_READ_ONLY=false

# Optionnel : force une URL IDhall par défaut (sinon déduite du claim `iss` du JWT utilisateur)
# IDHALL_BASE_URL=https://mon-entreprise.idhall.com

IDHALL_LANGUAGE=fr
IDHALL_TIMEZONE=Europe/Paris
